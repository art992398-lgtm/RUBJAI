rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile doc (currency, theme)
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // All per-user subcollections: transactions, budgets, accounts,
      // categories, recurring, categoryBudgets
      match /{sub}/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
